{
  "name": "lattice-gateway",
  "version": "0.1.0",
  "description": "Universal Extensible LLM Gateway and Harness Architecture",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:coverage": "bun test --coverage",
    "build": "bun build --compile --target=bun-windows-x64 ./bin/lattice.ts --outfile lattice.exe",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
